{
  "name": "moy-datsan",
  "private": true,
  "version": "0.0.1",
  "description": "Мой дацан — хуралы, зурхай, божества и буддийская философия",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "user"
  ],
  "scripts": {
    "dev": "concurrently -c yellow,cyan,magenta \"npm:dev:*\"",
    "dev:server": "npm run dev -w @datsan/server",
    "dev:user": "npm run dev -w @datsan/user",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
