# Образец настроек сервера. Настоящие значения — в server/.env (в git НЕ попадает, см. .gitignore).
#
# Как получить server/.env:
#   1) cp server/.env.example server/.env
#   2) npm run admin:password -w @datsan/server   ← спросит пароль и напечатает две строки
#   3) вставьте эти строки в server/.env вместо пустых ниже

# Порт, на котором слушает API
PORT=3001

# Хеш пароля администратора (сам пароль нигде не хранится)
ADMIN_PASSWORD_HASH=

# Секрет для подписи токенов входа (случайная строка от 32 символов)
JWT_SECRET=

# Папка для загруженных картинок (необязательно; по умолчанию server/uploads)
# UPLOAD_DIR=
